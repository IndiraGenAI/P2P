# ----------------------------------------------------------------------------
# P2P-ORG  ·  Frontend (Vite + React)  ·  Environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` (or `.env.local`) and adjust as needed.
# The allowed env-var prefixes (API_, MAIN_, APP_, ENABLE_, GOOGLE_, S3_)
# are configured in vite.config.ts via `envPrefix`. Only matching vars
# are exposed to the browser.
# NEVER put secrets here — anything in this file is shipped to the browser.
# ----------------------------------------------------------------------------

# --- API ---------------------------------------------------------------------
# Base URL for the back-service (masters, auth, vendor, items, etc.).
# Must match backend's PORT + PREFIX (see backend/back-service/.env).
API_BASE_URL=http://localhost:3010/bs

# Base URL for the main-service (purchase-request and other transactional modules).
# Must match backend's PORT + PREFIX (see backend/main-service/.env).
MAIN_API_BASE_URL=http://localhost:3011/ms
# Request timeout in milliseconds for HTTP calls
API_TIMEOUT=30000

# --- App identity ------------------------------------------------------------
APP_NAME=P2P-ORG
APP_TAGLINE=Procure-to-Pay

# --- Feature flags -----------------------------------------------------------
# "true" | "false"
ENABLE_DEVTOOLS=true

# --- AWS S3 ------------------------------------------------------------------
# Public S3 bucket used for direct browser uploads via the back-service
# pre-signed URL flow (`/common/presigned-url`). The bucket name is sent
# as `bucket_name` when requesting the pre-signed URL. The base URL is
# used to render uploaded files (e.g. profile images) in the UI.
S3_PUBLIC_BUCKET=
S3_PUBLIC_BASE_URL=

# --- Google Maps -------------------------------------------------------------
# Browser-key for the Google Maps JavaScript API (Places + Maps libraries).
# Used by the address autocomplete inputs in the Entity / Vendor masters.
